<script>
(function () {
  function forceGreyCanvas() {
    var bg = '243, 243, 243';
    var hex = '#f3f3f3';
    document.documentElement.style.setProperty('--color-background', bg);
    document.documentElement.style.setProperty('--gradient-background', hex);
    document.body.style.setProperty('--color-background', bg);
    document.body.style.setProperty('--gradient-background', hex);
    document.body.style.backgroundColor = hex;
    var main = document.getElementById('MainContent');
    if (main) {
      main.style.setProperty('--color-background', bg);
      main.style.backgroundColor = hex;
      main.querySelectorAll(':scope > .shopify-section').forEach(function (sec) {
        sec.style.setProperty('--color-background', bg);
        sec.style.backgroundColor = hex;
      });
    }
  }

  function layoutFacets() {
    var vertical = document.querySelector('.facets-vertical');
    if (!vertical) return;
    vertical.classList.add('motox-facets-layout');

    var toolbar = vertical.querySelector('.facets-vertical-form');
    if (toolbar && toolbar.parentElement !== vertical) {
      vertical.insertBefore(toolbar, vertical.firstChild);
    }
  }

  function placeWissen() {
    var form = document.querySelector(
      '.facets-vertical .facets__form-vertical, .facets-vertical form, #FacetFiltersForm'
    );
    if (!form) return;
    var heading = form.querySelector('.facets__heading--vertical, .facets__heading');
    if (!heading || heading.querySelector('.motox-facets-wissen')) return;

    var clearLink =
      form.querySelector('.active-facets__button-wrapper a') ||
      form.querySelector('a.facets__reset');

    var a = document.createElement('a');
    a.className = 'motox-facets-wissen';
    a.textContent = 'Wissen';
    if (clearLink && clearLink.href) {
      a.href = clearLink.href;
      a.addEventListener('click', function (e) {
        e.preventDefault();
        clearLink.click();
      });
    } else {
      a.href = window.location.pathname || '#';
      a.style.visibility = 'hidden';
      a.setAttribute('aria-hidden', 'true');
      a.tabIndex = -1;
    }
    heading.appendChild(a);
  }

  function run() {
    forceGreyCanvas();
    layoutFacets();
    placeWissen();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }

  document.addEventListener('shopify:section:load', run);
  document.addEventListener('click', function (e) {
    if (!e.target.closest('facet-filters-form, .facets-vertical, #FacetFiltersForm, .facets-vertical-form')) return;
    setTimeout(run, 400);
  });
})();
</script>
{% endif %}
