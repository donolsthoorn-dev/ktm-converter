{% comment %}
  Collectie-/zoekpagina: lichtgrijze pagina, witte filterkaart + producttegels.
  Plakken in layout/theme.liquid, direct vóór </body>.
{% endcomment %}
{% if request.page_type == 'collection' or request.page_type == 'search' %}
<style>
  :root {
    --motox-page-bg: #f3f3f3;
    --motox-tile: #ffffff;
    --motox-filter-accent: #1ca839;
    --motox-filter-line: #e6e6e6;
    --motox-filter-text: #111;
    --motox-brand-red: #c9290a;
    --motox-tile-radius: 4px;
    --motox-tile-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 8px rgba(0, 0, 0, 0.04);
  }

  /* —— Pagina: lichtgrijs forceren (Dawn color-scheme wint anders) —— */
  html:has(body.template-collection),
  html:has(body.template-search),
  body.template-collection,
  body.template-search {
    --color-background: 243, 243, 243 !important;
    --gradient-background: #f3f3f3 !important;
    background: #f3f3f3 !important;
    background-color: #f3f3f3 !important;
  }

  body.template-collection .gradient,
  body.template-search .gradient,
  body.template-collection #MainContent,
  body.template-search #MainContent,
  body.template-collection #MainContent > .shopify-section,
  body.template-search #MainContent > .shopify-section,
  body.template-collection .collection,
  body.template-collection .collection .page-width,
  body.template-collection .collection-hero,
  body.template-collection .collection-hero__inner,
  body.template-collection .collection-hero__text-wrapper,
  body.template-search .template-search,
  body.template-search .template-search__header,
  body.template-collection .facets-vertical,
  body.template-collection .product-grid-container,
  body.template-collection #ProductGridContainer,
  body.template-collection #MainContent .color-background-1,
  body.template-collection #MainContent .color-background-2,
  body.template-collection #MainContent [class*='color-scheme-'],
  body.template-search #MainContent .color-background-1,
  body.template-search #MainContent .color-background-2 {
    --color-background: 243, 243, 243 !important;
    --gradient-background: #f3f3f3 !important;
    background: #f3f3f3 !important;
    background-color: #f3f3f3 !important;
    background-image: none !important;
  }

  /* Witte tegels/filter */
  body.template-collection #product-grid .card-wrapper,
  body.template-collection #product-grid .card,
  body.template-collection #product-grid .card--standard .card__inner,
  body.template-collection #main-collection-filters,
  body.template-collection .facets-vertical > aside,
  body.template-search #product-grid .card-wrapper,
  body.template-search #product-grid .card {
    --color-background: 255, 255, 255 !important;
    background: #fff !important;
    background-color: #fff !important;
  }

  /* —— 5 kolommen desktop —— */
  @media screen and (min-width: 990px) {
    #product-grid.grid--2-col-desktop,
    #product-grid.grid--3-col-desktop,
    #product-grid.grid--4-col-desktop,
    #product-grid.grid--5-col-desktop,
    #product-grid.grid--6-col-desktop,
    #product-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }

  /* —— Layout: toolbar boven, filter = top productrij —— */
  @media screen and (min-width: 750px) {
    .facets-vertical.motox-facets-layout {
      display: grid !important;
      grid-template-columns: minmax(22rem, 26rem) minmax(0, 1fr) !important;
      grid-template-areas:
        'toolbar toolbar'
        'filters products' !important;
      column-gap: 1.6rem !important;
      row-gap: 1.2rem !important;
      align-items: start !important;
    }

    .facets-vertical.motox-facets-layout > .facets-vertical-form {
      grid-area: toolbar;
      width: 100%;
      margin: 0 !important;
    }

    .facets-vertical.motox-facets-layout > aside,
    .facets-vertical.motox-facets-layout > #main-collection-filters {
      grid-area: filters;
      align-self: start;
      margin-top: 0 !important;
    }

    .facets-vertical.motox-facets-layout > .product-grid-container,
    .facets-vertical.motox-facets-layout > #ProductGridContainer {
      grid-area: products;
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
  }

  /* —— Producttegels: wit op grijs —— */
  #product-grid,
  .product-grid {
    column-gap: 1.2rem !important;
    row-gap: 1.2rem !important;
  }

  #product-grid .grid__item,
  .product-grid .grid__item {
    padding: 0 !important;
  }

  #product-grid .card-wrapper,
  .product-grid .card-wrapper,
  #product-grid .card,
  .product-grid .card {
    background: var(--motox-tile) !important;
    background-color: var(--motox-tile) !important;
    border-radius: var(--motox-tile-radius) !important;
    box-shadow: var(--motox-tile-shadow);
    border: 1px solid rgba(0, 0, 0, 0.04);
    overflow: hidden;
    height: 100%;
  }

  #product-grid .card--standard .card__inner,
  .product-grid .card--standard .card__inner {
    background: var(--motox-tile) !important;
    border: 0 !important;
    border-radius: 0 !important;
  }

  #product-grid .card__content,
  .product-grid .card__content,
  #product-grid .card__information,
  .product-grid .card__information {
    padding: 1rem 1.2rem 1.2rem !important;
  }

  #product-grid .card__media,
  .product-grid .card__media,
  #product-grid .card__inner .media,
  .product-grid .card__inner .media {
    background: var(--motox-tile) !important;
  }

  #product-grid .card__heading,
  .product-grid .card__heading,
  #product-grid .card__heading a,
  .product-grid .card__heading a {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    color: #111 !important;
    letter-spacing: -0.01em;
  }

  #product-grid .card-information > .caption-with-letter-spacing,
  .product-grid .card-information > .caption-with-letter-spacing,
  #product-grid .card__information .caption-with-letter-spacing,
  .product-grid .card__information .caption-with-letter-spacing,
  #product-grid .card-information .caption,
  .product-grid .card-information .caption,
  #product-grid .vendor,
  .product-grid .vendor,
  #product-grid .card__vendor,
  .product-grid .card__vendor {
