    font-size: 1.15rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 0.35rem;
  }

  /* Merkenlogo rechtsonder op de tegel (naast prijs); vendortekst weg bij geladen logo */
  #product-grid .card-information__footer,
  .product-grid .card-information__footer {
    display: flex !important;
    align-items: flex-end !important;
    justify-content: space-between !important;
    gap: 0.8rem !important;
  }

  #product-grid .card-information__footer-main,
  .product-grid .card-information__footer-main {
    min-width: 0;
    flex: 1 1 auto;
  }

  #product-grid .motox-card-vendor-logo,
  .product-grid .motox-card-vendor-logo {
    display: block;
    flex: 0 0 auto;
    height: 2.4rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    object-position: right bottom;
    pointer-events: none;
    background: transparent;
    padding: 0;
    margin: 0;
  }

  #product-grid .motox-card--has-vendor-logo .card__vendor,
  .product-grid .motox-card--has-vendor-logo .card__vendor {
    display: none !important;
  }

  #product-grid .price,
  .product-grid .price,
  #product-grid .price-item,
  .product-grid .price-item {
    font-weight: 700;
    color: #111;
  }

  #product-grid .price .price-item--regular,
  .product-grid .price .price-item--regular,
  #product-grid .price .price-item--sale,
  .product-grid .price .price-item--sale {
    font-size: 1.55rem;
  }

  #product-grid .price--on-sale .price-item--regular,
  .product-grid .price--on-sale .price-item--regular {
    font-size: 1.25rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.45);
  }

  /* Badges: groen pill i.p.v. rond rood */
  #product-grid .badge,
  .product-grid .badge,
  #product-grid .card__badge .badge,
  .product-grid .card__badge .badge {
    border-radius: 999px !important;
    padding: 0.35rem 0.75rem !important;
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em;
    background: var(--motox-filter-accent) !important;
    color: #fff !important;
    border: 0 !important;
  }

  #product-grid .card__badge,
  .product-grid .card__badge {
    margin: 0.8rem !important;
  }

  /* Quick-add → groen vierkant (als Dawn quick add aan staat) */
  #product-grid .quick-add,
  .product-grid .quick-add {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    margin: 0 !important;
    z-index: 2;
