  @media screen and (max-width: 749px) {
    .facets-vertical-form {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      margin-bottom: 1rem;
    }

    .product-count-vertical {
      order: -1;
      margin: 0 !important;
      font-size: 1.3rem;
      font-weight: 600;
    }

    .facet-filters.sorting {
