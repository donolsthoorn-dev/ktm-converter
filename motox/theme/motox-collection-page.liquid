      margin: 0 !important;
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      box-sizing: border-box;
    }

    .facets-vertical .product-grid-container,
    .facets-vertical #ProductGridContainer {
      min-width: 0;
      width: 100%;
    }
  }

  /* Header Filter + Wissen */
  .facets-vertical .facets__heading--vertical,
  .facets-vertical .facets__heading {
    display: flex !important;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    box-sizing: border-box;
    margin: 0 !important;
    padding: 0 0 0.85rem !important;
    border-bottom: 1px solid var(--motox-filter-line) !important;
    font-size: 1.55rem !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--motox-filter-text) !important;
    text-transform: none !important;
  }

  .facets-vertical .motox-facets-wissen {
