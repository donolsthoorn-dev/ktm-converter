      margin: 0 !important;
      border: 1px solid rgba(0, 0, 0, 0.12) !important;
      border-radius: var(--motox-tile-radius) !important;
      background: var(--motox-tile) !important;
      box-shadow: var(--motox-tile-shadow);
      font-size: 1.3rem !important;
      font-weight: 500 !important;
      color: #111 !important;
      cursor: pointer;
    }

    .facet-filters__field .select .icon-caret,
    .facet-filters .select .icon-caret {
