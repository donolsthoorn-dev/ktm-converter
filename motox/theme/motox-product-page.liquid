    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0;
    padding-left: 2.4rem;
    border-left: 0.1rem solid rgba(var(--color-foreground), 0.15);
    font-size: 1.4rem;
    font-weight: 650;
    line-height: 1.3;
    text-align: left;
  }

  .motox-stock__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.5rem;
  }

  .motox-stock__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    color: #fff;
  }

  .motox-stock__mark svg {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }

  .motox-stock--in {
    color: #090;
  }

  .motox-stock--in .motox-stock__mark {
    background: #090;
  }

  .motox-stock--eta {
    color: #c45c00;
  }

  .motox-stock--eta .motox-stock__mark {
    background: #c45c00;
  }

  .motox-stock__detail {
    margin: 0;
    font-weight: 450;
    font-size: 1.4rem;
    line-height: 1.3;
    color: rgba(var(--color-foreground), 0.65);
  }

  /* Bihr CDN logos are ~128×64 — show near-native, no pre-rendered canvas */
  .motox-vendor img {
    display: block;
    height: 5.6rem !important;
    width: auto !important;
    max-width: 18rem !important;
    object-fit: contain;
    object-position: left center;
    background: #fff;
  }

  .motox-brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin: 0 0 0.4rem !important;
    padding: 0 !important;
    min-height: 0 !important;
    height: auto !important;
  }

  .motox-brand-row .product__text,
  .motox-brand-row .motox-vendor {
    display: block;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 0 !important;
    min-height: 0 !important;
    height: auto !important;
    color: #c9290a;
    font-weight: 700;
  }

  .motox-brand-row share-button {
    margin: 0 0 0 auto !important;
    padding: 0 !important;
    flex: 0 0 auto;
    align-self: center;
    line-height: 1;
  }

  .motox-brand-row share-button .share-button__button {
    min-height: 0 !important;
    height: auto !important;
    padding: 0 !important;
    margin: 0 !important;
