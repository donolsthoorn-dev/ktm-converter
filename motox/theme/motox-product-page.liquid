  }

  .product__info-container .product__ymm {
    display: block;
    margin: 0.6rem 0 1rem;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: rgb(var(--color-foreground));
  }

  .product__info-container .product__ymm .product__label {
