{% comment %}
  Productpagina: vendorlogo, prijs, voorraad/ETA, aantal naast winkelwagen, tabs.
  Plakken in layout/theme.liquid, direct vóór </body>.
  Logo's: Shopify admin → Content → Files.
  Bestandsnaam: merk-{vendor}.png  (kleine letters, spaties worden streepjes).
  Voorbeeld: RACETECH → merk-racetech.png
{% endcomment %}
{% if request.page_type == 'product' %}
  {% assign motox_ymm_summary = product.metafields.global.ymm_summary.value | default: product.metafields.global.ymm_summary %}
  {% if motox_ymm_summary != blank %}
<template id="motox-ymm-template"><p class="product__ymm"><span class="product__label">Past op:</span> {{ motox_ymm_summary | escape }}</p></template>
  {% endif %}
<style>
  .product__info-container .price--large .price-item--regular,
  .product__info-container .price--large .price-item--sale {
    font-size: 3.2rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .motox-price-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    column-gap: 2.4rem;
    margin: 0.4rem 0 1.2rem;
  }

  .motox-price-row .price {
    margin: 0;
  }

  .motox-price-row .product__tax {
    margin: 0.4rem 0 0;
    font-size: 1.4rem;
    line-height: 1.3;
    color: rgba(var(--color-foreground), 0.65);
  }

  .motox-stock {
